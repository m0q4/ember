# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://ember:ember@localhost:5432/ember

# --- JWT (sessioni dashboard admin) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# --- Discord OAuth2 (login dashboard) ---
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_GUILD_ID=CHANGE_ME
DISCORD_ADMIN_ROLE_ID=CHANGE_ME

# URL della dashboard web, usato per il redirect dopo il login Discord
DASHBOARD_URL=http://localhost:5199

# Chiave usata per creare la prima server API key via script (vedi src/scripts/createServer.js)
BOOTSTRAP_ADMIN_TOKEN=CHANGE_ME
